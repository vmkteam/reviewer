{
  "name": "reviewsrv-frontend",
  "private": true,
  "version": "0.0.3",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "dev:vt": "vite --config vite.config.vt.ts",
    "build": "vue-tsc -b && vite build",
    "build:vt": "vue-tsc -b && vite build --config vite.config.vt.ts",
    "build:all": "vue-tsc -b && vite build && vite build --config vite.config.vt.ts",
    "preview": "vite preview"
  },
  "dependencies": {
    "@headlessui/vue": "^1.7.23",
    "highlight.js": "^11.12.0",
    "markdown-it": "^15.0.2",
    "mermaid": "^11.17.2",
    "ofetch": "^1.5.1",
    "ufo": "^1.6.4",
    "vue": "^3.5.43",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-vue": "^6.0.9",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vite": "^8.3.1",
    "vue-tsc": "^3.3.11"
  }
}
