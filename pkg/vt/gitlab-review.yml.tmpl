spec:
  inputs:
    stage:
      type: string
      default: check

    job_name:
      type: string
      default: claude-code-review

    dockerimage:
      type: string
      # CI image = vmkteam/claude-ci (Claude Code) + reviewctl. Build it from the
      # Dockerfile in the reviewer "CI Setup", push to your registry, point here.
      default: your-registry/reviewer-ci:latest

    stub_rules:
      type: array
      default:
        - if: '$CI_PIPELINE_SOURCE == "merge_request_event"'
        - when: never

    rules:
      type: array
      default:
        - if: '$CI_PIPELINE_SOURCE == "merge_request_event"'
          when: manual
          allow_failure: true
        - when: never

    tags:
      type: array
      default: []

---

pipeline-ok:
  stage: check
  tags: $[[ inputs.tags ]]
  script:
    - echo "pipeline ok"
  rules: $[[ inputs.stub_rules ]]

# Required CI/CD variables: PROJECT_KEY, REVIEWSRV_URL.
# LLM credentials: the runner profile (configured on the server) supplies the runner,
# model and an optional API token. Provide a key here only when the profile has none —
# REVIEW_API_KEY (provider-agnostic) or the provider-specific var
# (ANTHROPIC_API_KEY / OPENAI_API_KEY / DEEPSEEK_API_KEY). reviewctl fails fast if no
# credential is available from either the profile or the environment.
# Optional: REVIEWSRV_PUBLIC_URL — browser-facing URL for MR comment links when it differs from REVIEWSRV_URL (e.g. internal vs public DNS).
$[[ inputs.job_name ]]:
  image: $[[ inputs.dockerimage ]]
  stage: $[[ inputs.stage ]]
  tags: $[[ inputs.tags ]]
  variables:
    GIT_DEPTH: 100
  # Session cache for the Claude runner: re-running the review on the same MR
  # reuses the prior session (--continue), so Claude reads its prompt cache
  # instead of rebuilding it (~90% input-token savings). Safe no-op for the
  # opencode/codex/direct runners — the restore/detect/save steps below find no
  # Claude session, so --continue stays empty and the runner starts fresh.
  cache:
    key: "claude-review-${CI_MERGE_REQUEST_IID}"
    paths:
      - .claude-cache/
  script:
    - |
      missing=0

      for var in PROJECT_KEY REVIEWSRV_URL; do
        if [ -z "${!var}" ]; then
          echo "ERROR: required env var '$var' is not set" >&2
          missing=1
        fi
      done

      if [ "$missing" -ne 0 ]; then
        exit 1
      fi
    - git fetch --depth=20 --force origin $CI_MERGE_REQUEST_TARGET_BRANCH_NAME:$CI_MERGE_REQUEST_TARGET_BRANCH_NAME
    - |
      # Restore cached Claude session into its project dir (Claude runner only).
      CACHED_SESSION=$(find .claude-cache/projects -name '*.jsonl' -print -quit 2>/dev/null)
      if [ -n "$CACHED_SESSION" ]; then
        CACHED_PROJECT_DIR=$(dirname "$CACHED_SESSION")
        CURRENT_HASH=$(echo "$PWD" | sed 's|/|-|g; s|^-||')
        TARGET_DIR="/root/.claude/projects/$CURRENT_HASH"
        mkdir -p "$TARGET_DIR"
        cp -r "$CACHED_PROJECT_DIR"/* "$TARGET_DIR/"
        echo "Restored cached Claude session into $TARGET_DIR"
      fi
    - |
      REVIEWCTL_CONTINUE=""
      if find /root/.claude/projects -name '*.jsonl' -print -quit 2>/dev/null | grep -q .; then
        REVIEWCTL_CONTINUE="--continue"
        echo "Resuming previous session"
      fi
    - reviewctl review $REVIEWCTL_CONTINUE --verbose
    - |
      # Save the Claude session for the next run (no-op when no Claude session exists).
      CURRENT_HASH=$(echo "$PWD" | sed 's|/|-|g; s|^-||')
      SOURCE_DIR="/root/.claude/projects/$CURRENT_HASH"
      if [ -d "$SOURCE_DIR" ]; then
        mkdir -p ".claude-cache/projects/$CURRENT_HASH"
        cp -r "$SOURCE_DIR"/* ".claude-cache/projects/$CURRENT_HASH/"
        echo "Saved Claude session from $SOURCE_DIR"
      fi
  artifacts:
    paths:
      - "review.html"
    when: always
  rules: $[[ inputs.rules ]]