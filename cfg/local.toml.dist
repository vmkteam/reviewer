[Server]
Host      = "localhost"
Port      = 8075
IsDevel   = true
BaseURL   = "http://localhost:8075"

[Database]
Addr            = "localhost:5432"
User            = "postgres"
Database        = "reviewsrv"
Password        = ""
PoolSize        = 5
ApplicationName = "reviewsrv"

[Sentry]
DSN         = ""
Environment = ""

# In-memory ring of recent reviewctl runs at /v1/debug/storage/ (defaults shown).
[Debug]
Capacity      = 200 # runs kept (metadata)
FilesCapacity = 20  # newest runs that keep their artifact files
